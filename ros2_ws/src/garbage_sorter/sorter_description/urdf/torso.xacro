<?xml version="1.0"?>
<!--The torso the arm is mounted on. A plain box standing on the floor,
fixed to the world so the arm can't tip it over.-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--Dimensions in metres and mass in kg. Everything below is derived
  from these, so changing a number here changes the whole torso.-->
  <xacro:property name="torso_x" value="0.3"/>
  <xacro:property name="torso_y" value="0.3"/>
  <xacro:property name="torso_z" value="0.5"/>
  <xacro:property name="torso_mass" value="20"/>

  <link name="torso_link">
    <!--The link's origin is at the bottom of the box, so the box is
    drawn half its height up.-->
    <!--What is drawn in RViz and Gazebo.-->
    <visual>
      <origin xyz="0 0 ${torso_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_x} ${torso_y} ${torso_z}"/>
      </geometry>
    </visual>
    <!--What the physics engine uses. Same box as the visual.-->
    <collision>
      <origin xyz="0 0 ${torso_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_x} ${torso_y} ${torso_z}"/>
      </geometry>
    </collision>
    <!--Mass and inertia, at the centre of the box.
    Solid box: Ixx = m(y²+z²)/12, Iyy = m(x²+z²)/12, Izz = m(x²+y²)/12-->
    <inertial>
      <origin xyz="0 0 ${torso_z/2}" rpy="0 0 0"/>
      <mass value="${torso_mass}"/>
      <inertia ixx="${torso_mass*(torso_y**2 + torso_z**2)/12}" ixy="0" ixz="0"
               iyy="${torso_mass*(torso_x**2 + torso_z**2)/12}" iyz="0"
               izz="${torso_mass*(torso_x**2 + torso_y**2)/12}"/>
    </inertial>
  </link>

  <!--Bolted to the world. Without this the torso is a free body and
  falls over the first time the arm swings.-->
  <joint name="torso_joint" type="fixed">
    <parent link="world"/>
    <child link="torso_link"/>
    <!--The torso stands at the world origin.-->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>

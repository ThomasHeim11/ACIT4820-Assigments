<?xml version="1.0"?>
<!--Top level of the sorter. Holds no geometry of its own, it only pulls the
parts together: the torso, and a UR5e arm standing on it.-->
<robot name="sorter" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--Every robot fixed in place needs a world link to be fixed to.-->
  <link name="world"/>

  <!--The torso first, since the arm below uses torso_z.-->
  <xacro:include filename="torso.xacro"/>
  <!--The UR macro. It writes all the arm's links and joints when called.-->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <!--Which UR model. All four parameter files come from this folder.-->
  <xacro:property name="ur_type" value="ur5e"/>
  <xacro:property name="ur_config" value="$(find ur_description)/config/${ur_type}"/>

  <!--One arm on top of the torso. tf_prefix is empty for now; with two
  arms it becomes left_ and right_ so the joint names don't clash.
  force_abs_paths gives the meshes full file paths, because Gazebo
  can't resolve package:// URIs without extra setup.-->
  <xacro:ur_robot name="ur" tf_prefix="" parent="torso_link"
                  joint_limits_parameters_file="${ur_config}/joint_limits.yaml"
                  kinematics_parameters_file="${ur_config}/default_kinematics.yaml"
                  physical_parameters_file="${ur_config}/physical_parameters.yaml"
                  visual_parameters_file="${ur_config}/visual_parameters.yaml"
                  force_abs_paths="true">
    <!--Where the arm's base sits: on the top face of the torso.-->
    <origin xyz="0 0 ${torso_z}" rpy="0 0 0"/>
  </xacro:ur_robot>

</robot>

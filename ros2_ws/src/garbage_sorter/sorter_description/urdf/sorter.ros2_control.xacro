<?xml version="1.0"?>
<!--Connects the arm's joints to ros2_control, and loads the Gazebo plugin
that runs it.-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--UR's own list of the six joints and their interfaces. Reused so we
  don't write out all the joints ourselves.-->
  <xacro:include filename="$(find ur_description)/urdf/inc/ur_joint_control.xacro"/>

  <xacro:macro name="sorter_ros2_control" params="tf_prefix controllers_file">

    <!--The hardware is Gazebo. On a real robot this plugin would be UR's
    driver instead, and nothing else would change.-->
    <ros2_control name="${tf_prefix}ur" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <!--The six joints, each with position/velocity/effort interfaces
      and a starting angle.-->
      <xacro:ur_joint_control_description tf_prefix="${tf_prefix}"/>
    </ros2_control>

    <!--Loads gz_ros2_control into Gazebo. It reads the tag above and starts
    the controller_manager with the controllers in the file.-->
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>

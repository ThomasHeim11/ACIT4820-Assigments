<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sorter">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import sorter urdf file -->
    <xacro:include filename="$(find sorter_description)/urdf/sorter.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="sorter.ros2_control.xacro" />


    <xacro:sorter_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>

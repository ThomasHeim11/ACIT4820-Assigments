<?xml version="1.0" ?>
<!--The sorting cell: a conveyor belt in front of the robot that the waste
lies on, and four bins behind the robot, one per waste class.
The robot itself is not in here. It is spawned from the URDF by the launch
file, at the world origin.-->
<sdf version="1.8">
  <world name="sorting">

    <!--The same Gazebo systems as the A3/A4 maze. Sensors uses ogre2,
    which the camera will need later.-->
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--What the belt stands on. Only there so the belt isn't floating.
    Its top is at z = 0.3.-->
    <model name="belt_stand">
      <static>true</static>
      <pose>0.5 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 1.2 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 1.2 0.3</size></box></geometry>
          <material><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--The conveyor belt, built on Gazebo's conveyor example. It runs
    across in front of the arm, along y. The belt surface is at z = 0.4.
    Speed is set on /model/conveyor/link/base_link/track_cmd_vel (m/s).
    It starts at 0, so until something publishes a speed it is a table.-->
    <model name="conveyor">
      <static>true</static>
      <!--Turned 90 degrees (yaw = pi/2), because the belt moves along its
      own x and we want it to run along the world's y.-->
      <pose>0.5 0 0.35 0 0 1.570796327</pose>
      <link name="base_link">

        <!--The belt surface. The friction settings are from Gazebo's
        example. They make objects grip the belt and ride along.-->
        <collision name="belt_collision">
          <geometry><box><size>1.2 0.3 0.1</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.7</mu><mu2>150</mu2><fdir1>0 1 0</fdir1></ode>
            </friction>
          </surface>
        </collision>
        <visual name="belt_visual">
          <geometry><box><size>1.2 0.3 0.1</size></box></geometry>
          <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>

        <!--A roller at each end, so the ends are round like a real belt.-->
        <collision name="roller_front_collision">
          <pose>0.6 0 0 -1.570796327 0 0</pose>
          <geometry><cylinder><length>0.3</length><radius>0.05</radius></cylinder></geometry>
          <surface>
            <friction>
              <ode><mu>0.7</mu><mu2>150</mu2><fdir1>0 1 0</fdir1></ode>
            </friction>
          </surface>
        </collision>
        <visual name="roller_front_visual">
          <pose>0.6 0 0 -1.570796327 0 0</pose>
          <geometry><cylinder><length>0.3</length><radius>0.05</radius></cylinder></geometry>
          <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>

        <collision name="roller_back_collision">
          <pose>-0.6 0 0 -1.570796327 0 0</pose>
          <geometry><cylinder><length>0.3</length><radius>0.05</radius></cylinder></geometry>
          <surface>
            <friction>
              <ode><mu>0.7</mu><mu2>150</mu2><fdir1>0 1 0</fdir1></ode>
            </friction>
          </surface>
        </collision>
        <visual name="roller_back_visual">
          <pose>-0.6 0 0 -1.570796327 0 0</pose>
          <geometry><cylinder><length>0.3</length><radius>0.05</radius></cylinder></geometry>
          <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>

      <!--Gazebo's built-in system that moves the belt surface. It listens
      for a speed on .../base_link/track_cmd_vel.-->
      <plugin filename="gz-sim-track-controller-system"
              name="gz::sim::systems::TrackController">
        <link>base_link</link>
        <odometry_publish_frequency>1</odometry_publish_frequency>
      </plugin>
    </model>

    <!--The four bins. Each is an open box, 25 x 25 cm and 15 cm high:
    a bottom and four walls. The walls' poses are measured from the bin's
    centre, so moving a bin only means changing its own pose.-->

    <!--Plastic bin, blue.-->
    <model name="bin_plastic">
      <static>true</static>
      <pose>-0.45 -0.375 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom_collision">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.25 0.25 0.01</size></box></geometry>
        </collision>
        <visual name="bottom_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.25 0.25 0.01</size></box></geometry>
          <material><diffuse>0.2 0.4 0.9 1</diffuse></material>
        </visual>

        <collision name="wall_front_collision">
          <pose>0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
        </collision>
        <visual name="wall_front_visual">
          <pose>0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
          <material><diffuse>0.2 0.4 0.9 1</diffuse></material>
        </visual>

        <collision name="wall_back_collision">
          <pose>-0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
        </collision>
        <visual name="wall_back_visual">
          <pose>-0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
          <material><diffuse>0.2 0.4 0.9 1</diffuse></material>
        </visual>

        <collision name="wall_left_collision">
          <pose>0 0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
        </collision>
        <visual name="wall_left_visual">
          <pose>0 0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
          <material><diffuse>0.2 0.4 0.9 1</diffuse></material>
        </visual>

        <collision name="wall_right_collision">
          <pose>0 -0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
        </collision>
        <visual name="wall_right_visual">
          <pose>0 -0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
          <material><diffuse>0.2 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--Paper bin, brown.-->
    <model name="bin_paper">
      <static>true</static>
      <pose>-0.45 -0.125 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom_collision">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.25 0.25 0.01</size></box></geometry>
        </collision>
        <visual name="bottom_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.25 0.25 0.01</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>

        <collision name="wall_front_collision">
          <pose>0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
        </collision>
        <visual name="wall_front_visual">
          <pose>0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>

        <collision name="wall_back_collision">
          <pose>-0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
        </collision>
        <visual name="wall_back_visual">
          <pose>-0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>

        <collision name="wall_left_collision">
          <pose>0 0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
        </collision>
        <visual name="wall_left_visual">
          <pose>0 0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>

        <collision name="wall_right_collision">
          <pose>0 -0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
        </collision>
        <visual name="wall_right_visual">
          <pose>0 -0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--Metal bin, grey.-->
    <model name="bin_metal">
      <static>true</static>
      <pose>-0.45 0.125 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom_collision">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.25 0.25 0.01</size></box></geometry>
        </collision>
        <visual name="bottom_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.25 0.25 0.01</size></box></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>

        <collision name="wall_front_collision">
          <pose>0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
        </collision>
        <visual name="wall_front_visual">
          <pose>0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>

        <collision name="wall_back_collision">
          <pose>-0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
        </collision>
        <visual name="wall_back_visual">
          <pose>-0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>

        <collision name="wall_left_collision">
          <pose>0 0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
        </collision>
        <visual name="wall_left_visual">
          <pose>0 0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>

        <collision name="wall_right_collision">
          <pose>0 -0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
        </collision>
        <visual name="wall_right_visual">
          <pose>0 -0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--Glass bin, green.-->
    <model name="bin_glass">
      <static>true</static>
      <pose>-0.45 0.375 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom_collision">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.25 0.25 0.01</size></box></geometry>
        </collision>
        <visual name="bottom_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.25 0.25 0.01</size></box></geometry>
          <material><diffuse>0.2 0.7 0.3 1</diffuse></material>
        </visual>

        <collision name="wall_front_collision">
          <pose>0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
        </collision>
        <visual name="wall_front_visual">
          <pose>0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
          <material><diffuse>0.2 0.7 0.3 1</diffuse></material>
        </visual>

        <collision name="wall_back_collision">
          <pose>-0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
        </collision>
        <visual name="wall_back_visual">
          <pose>-0.12 0 0.075 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.15</size></box></geometry>
          <material><diffuse>0.2 0.7 0.3 1</diffuse></material>
        </visual>

        <collision name="wall_left_collision">
          <pose>0 0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
        </collision>
        <visual name="wall_left_visual">
          <pose>0 0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
          <material><diffuse>0.2 0.7 0.3 1</diffuse></material>
        </visual>

        <collision name="wall_right_collision">
          <pose>0 -0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
        </collision>
        <visual name="wall_right_visual">
          <pose>0 -0.12 0.075 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.15</size></box></geometry>
          <material><diffuse>0.2 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

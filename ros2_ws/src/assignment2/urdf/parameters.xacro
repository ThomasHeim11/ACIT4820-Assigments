<?xml version="1.0"?>
<!--Dimensions and materials. Included first, because everything below it
refers to these values.-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!--Every dimension is written once here-->
<!--Chassis box-->
<xacro:property name="base_length" value="0.6"/>
<xacro:property name="base_width" value="0.4"/>
<xacro:property name="base_height" value="0.1"/>
<!--Drive wheels-->
<xacro:property name="wheel_radius" value="0.1"/>
<xacro:property name="wheel_thickness" value="0.1"/>
<!--How far behind the chassis centre the wheel sit-->
<xacro:property name="wheel_x_offset" value="-0.1"/>
<!--Distance between the two wheel centres-->
<xacro:property name="wheel_separation" value="${base_width + wheel_thickness}"/>
<!--Front caster-->
<xacro:property name="caster_radius" value="0.05"/>
<xacro:property name="caster_x_offset" value="0.2"/>

<!--Materials-->
<material name="blue">
  <color rgba="0.2 0.4 0.8 1.0"/>
</material>
<material name="dark_grey">
  <color rgba="0.2 0.2 0.2 1.0"/>
</material>
<material name="light_grey">
  <color rgba="0.7 0.7 0.7 1.0"/>
</material>

<!--Masses-->
<xacro:property name="base_mass" value="5.0"/>
<xacro:property name="wheel_mass" value="0.5"/>
<xacro:property name="caster_mass" value="0.2"/>
<!--LiDAR-->
<xacro:property name="lidar_mass" value="0.1"/>
<xacro:property name="lidar_radius" value="0.05"/>
<xacro:property name="lidar_length" value="0.1"/>

<!--Tensor for the primitive shapes.
Each takes a mass and the dimensions.-->
<xacro:macro name="inertial_box" params="mass length width height">
  <inertial>
    <mass value="${mass}"/>
    <inertia ixx="${mass*(width*width + height*height)/12}" ixy="0" ixz="0"
             iyy="${mass*(length*length + height*height)/12}" iyz="0"
             izz="${mass*(length*length + width*width)/12}"/>
  </inertial>
</xacro:macro>

<xacro:macro name="inertial_cylinder" params="mass radius length">
  <inertial>
    <mass value="${mass}"/>
    <inertia ixx="${mass*(3*radius*radius + length*length)/12}" ixy="0" ixz="0"
             iyy="${mass*(3*radius*radius + length*length)/12}" iyz="0"
             izz="${mass*radius*radius/2}"/>
  </inertial>
</xacro:macro>

<xacro:macro name="inertial_sphere" params="mass radius">
  <inertial>
    <mass value="${mass}"/>
    <inertia ixx="${2*mass*radius*radius/5}" ixy="0" ixz="0"
             iyy="${2*mass*radius*radius/5}" iyz="0"
             izz="${2*mass*radius*radius/5}"/>
  </inertial>
</xacro:macro>

</robot>

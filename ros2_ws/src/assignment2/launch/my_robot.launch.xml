<?xml version="1.0"?>
<!--Brings up the simulation: Gazebo with the custom world, the
robot spawned into it, the bridge between Gazebo and ROS2, and RViz-->

<launch>
<arg name="headless" default="false"
    description="Run Gazebo without the GUI client"/>
<!--Paths resolved from the installed package.-->
<let name="pkg_share" value="$(find-pkg-share assignment2)"/>
<let name="xacro_path" value="$(var pkg_share)/urdf/my_robot.urdf.xacro"/>
<let name="world_path" value="$(var pkg_share)/worlds/my_world.world"/>
<let name="bridge_config_path" value="$(var pkg_share)/config/gz_bridge.yaml"/>
<let name="rviz_config" value="$(var pkg_share)/rviz/urdf_config.rviz"/>

<!--gz_server computes the physics, gz_client draws it. The client can be
skipped when only RViz is needed.-->
<executable cmd="gz sim -s -r $(var world_path)" name="gz_server" output="screen"/>
<executable cmd="gz sim -g" name="gz_client" output="screen"
            unless="$(var headless)"/>

<!--Expands the xacro, publishes it on /robot_description, and turns joint
states into transforms.-->
<node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description"
        value="$(command 'xacro $(var xacro_path)')" type="str"/>
    <param name="use_sim_time" value="true"/>
</node>

<!--Reads the description off /robot_description and spawns it. The name
must match the one used in the bridge config.-->
<node pkg="ros_gz_sim" exec="create"
      args="-topic robot_description -name my_robot -z 0.05"/>

<!--Passes topics between Gazebo and ROS, as listed in the config file.-->
<node pkg="ros_gz_bridge" exec="parameter_bridge">
    <param name="config_file" value="$(var bridge_config_path)"/>
    <param name="use_sim_time" value="true"/>
</node>

<!--RViz with the saved config: fixed frame base_footprint-->
<node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config)">
    <param name="use_sim_time" value="true"/>
</node>
</launch> 
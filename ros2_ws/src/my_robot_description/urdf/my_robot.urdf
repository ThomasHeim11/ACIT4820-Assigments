<?xml version="1.0"?>
<robot name="my_robot">

<!--Root of the TF tree. This is a ground level frame -->
<link name="base_footprint"/>

<!--This is a fixed joint that holds the chassis above the ground -->
<joint name="base_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 0.1" rpy="0 0 0"/>
</joint>

<!--Contains the body of the robot with box geometry 
and is parent to every other link.-->
<link name="base_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.6 0.4 0.1"/>
    </geometry>
    <material name="blue">
      <color rgba="0.2 0.4 0.8 1.0"/>
    </material>
  </visual>
</link>

<!--Left drive wheel. The cylinder is left standing up here,
because the joint below turns the whole wheel frame instead.-->
<link name="left_wheel">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.1" length="0.1"/>
    </geometry>
    <material name="dark_grey">
      <color rgba="0.2 0.2 0.2 1.0"/>
    </material>
  </visual>
</link>

<!--Continuous joint so the wheel can rotate freely. The rpy tips the
wheel frame a quarter turn, which both lays the cylinder flat and points
its own z axis sideways, so the axis below is the rolling axis.-->
<joint name="left_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="left_wheel"/>
  <origin xyz="-0.1 0.25 0" rpy="-1.5708 0 0"/>
  <axis xyz="0 0 1"/>
</joint>

<!--Right drive wheel. Same as left wheel.-->
<link name="right_wheel">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.1" length="0.1"/>
    </geometry>
    <material name="dark_grey"/>
  </visual>
</link>

<!--Mirrored joint for the right wheel. Same rpy and same axis as the
left wheel, so both wheels turn the same direction for the same value.-->
<joint name="right_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="right_wheel"/>
  <origin xyz="-0.1 -0.25 0" rpy="-1.5708 0 0"/>
  <axis xyz="0 0 1"/>
</joint>

<!--Caster wheel. A sphere assumed to roll in any direction.-->
<link name="caster_wheel">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.05"/>
    </geometry>
    <material name="light_grey">
      <color rgba="0.7 0.7 0.7 1.0"/>
    </material>
  </visual>
</link>

<!-- This is a fixed joint at the front. -->
<joint name="caster_joint" type="fixed">
  <parent link="base_link"/>
  <child link="caster_wheel"/>
  <origin xyz="0.2 0 -0.05" rpy="0 0 0"/>
</joint>

</robot>

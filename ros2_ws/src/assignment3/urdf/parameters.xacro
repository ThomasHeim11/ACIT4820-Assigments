<?xml version="1.0"?>
<!--Dimensions, masses and materials. Included first, because everything below
it refers to these values.-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!--Shortcut to the mesh folder, so each visual only writes a file name.
$(find assignment3) is the installed package path, filled in by xacro.-->
<xacro:property name="mesh_dir" value="file://$(find assignment3)/meshes"/>

<!--============ SIZES, READ OFF THE DIAGRAM ============-->
<!--Numbers from assigment3-->

<!--Chassis: 32 cm across and 6 cm tall, riding 2 cm off the ground-->
<xacro:property name="base_radius" value="0.16"/>
<xacro:property name="base_height" value="0.06"/>
<xacro:property name="ground_clearance" value="0.02"/>

<!--Drive wheels: 6 cm across, 2.5 cm wide, 26 cm apart, 3 cm behind centre-->
<xacro:property name="wheel_radius" value="0.03"/>
<xacro:property name="wheel_thickness" value="0.025"/>
<xacro:property name="wheel_separation" value="0.26"/>
<xacro:property name="wheel_x_offset" value="-0.03"/>

<!--Caster: 4 cm sphere, 12 cm ahead of centre-->
<xacro:property name="caster_radius" value="0.02"/>
<xacro:property name="caster_x_offset" value="0.12"/>

<!--LiDAR: 6 cm across, 1 cm tall, 8 cm ahead of centre-->
<xacro:property name="lidar_radius" value="0.03"/>
<xacro:property name="lidar_height" value="0.01"/>
<xacro:property name="lidar_x_offset" value="0.08"/>

<!--============ WORKED OUT FROM THE SIZES ============-->
<!--Height of the chassis centre above the ground. Every part below hangs
off this one value, so raising the robot moves the whole body together.-->
<xacro:property name="base_z" value="${ground_clearance + base_height/2}"/>

<!--============ MASSES, FROM THE LINK TABLE ============-->
<xacro:property name="base_mass" value="5.0"/>
<xacro:property name="wheel_mass" value="0.2"/>
<xacro:property name="caster_mass" value="0.1"/>
<xacro:property name="lidar_mass" value="0.1"/>

<!--============ MATERIALS ============-->
<!--Only the caster needs one. The other links are drawn with meshes,
which carry their own colours.-->
<material name="light_grey">
  <color rgba="0.7 0.7 0.7 1.0"/>
</material>

<!--============ INERTIA ============-->
<!--Tensor for the primitive shapes. Each takes a mass and the dimensions.-->
<xacro:macro name="inertial_cylinder" params="mass radius length">
  <inertial>
    <mass value="${mass}"/>
    <inertia ixx="${mass*(3*radius*radius + length*length)/12}" ixy="0" ixz="0"
             iyy="${mass*(3*radius*radius + length*length)/12}" iyz="0"
             izz="${mass*radius*radius/2}"/>
  </inertial>
</xacro:macro>

<xacro:macro name="inertial_sphere" params="mass radius">
  <inertial>
    <mass value="${mass}"/>
    <inertia ixx="${2*mass*radius*radius/5}" ixy="0" ixz="0"
             iyy="${2*mass*radius*radius/5}" iyz="0"
             izz="${2*mass*radius*radius/5}"/>
  </inertial>
</xacro:macro>

</robot>

<?xml version="1.0"?>
<!--The robot itself: the wheel macro, then the links and joints. Uses the
dimensions and materials from parameters.urdf.xacro.-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!--Wheel macro that have both the link and the joint,and takes a names and
position-->
<xacro:macro name="drive_wheel" params="prefix x_offset y_offset">
<!--The cylinder stays upright. The joint below lays it flat -->
  <link name="${prefix}_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}"
                             length="${wheel_thickness}"/>
  </link>

   <!--The rpy lays the cylinder flat and points its z sideways, making z
  the rolling axis.-->
  <joint name="${prefix}_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="${prefix}_wheel"/>
    <origin xyz="${x_offset} ${y_offset} 0" rpy="${-pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

</xacro:macro>

<!--============================ LINKS ============================-->
<!--Root of the TF tree-->
<link name="base_footprint"/>

<!--Body of the robot-->
<link name="base_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="${base_length} ${base_width} ${base_height}"/>
    </geometry>
    <material name="blue"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="${base_length} ${base_width} ${base_height}"/>
    </geometry>
  </collision>
  <xacro:inertial_box mass="${base_mass}" length="${base_length}"
                      width="${base_width}" height="${base_height}"/>
</link>

<!--Front caster-->
<link name="caster_wheel">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="${caster_radius}"/>
    </geometry>
    <material name="light_grey"/>
  </visual>

  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="${caster_radius}"/>
    </geometry>
  </collision>
  <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}"/>
</link>

<!--============================ JOINTS ===========================-->
<!--Lifts the body off the ground. The lift is one wheel radius, so the
wheels end up resting exactly on the floor.-->
<joint name="base_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
</joint>

<!--Drops the caster until its underside reaches the ground.-->
<joint name="caster_joint" type="fixed">
  <parent link="base_link"/>
  <child link="caster_wheel"/>
  <origin xyz="${caster_x_offset} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
</joint>

<!--============================ WHEELS ===========================-->
<!--The two drive wheels, both built from the macros-->

<xacro:drive_wheel prefix="left" x_offset="${wheel_x_offset}"
                   y_offset="${wheel_separation/2}"/>

<xacro:drive_wheel prefix="right" x_offset="${wheel_x_offset}"
                   y_offset="${-wheel_separation/2}"/>

</robot>

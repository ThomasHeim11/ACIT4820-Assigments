<?xml version="1.0"?>
<!--The LiDAR: its link, the joint holding it on the chassis, and the
Gazebo sensor that produces the scan.-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="lidar_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/doomba_lidar.dae"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${lidar_mass}" radius="${lidar_radius}"
                                 length="${lidar_height}"/>
    </link>

    <!--Sits on the chassis roof, ahead of centre: half the body up, then
    half the sensor-->
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="${lidar_x_offset} 0 ${base_height/2 + lidar_height/2}"
                rpy="0 0 0"/>
    </joint>

    <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
            <topic>scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <update_rate>30</update_rate>
            <always_on>1</always_on>
            <visualize>true</visualize>
            <ray>
                <scan>
                    <horizontal>
                        <samples>${lidar_rays}</samples>
                        <resolution>1</resolution>
                        <min_angle>${-lidar_half_fov}</min_angle>
                        <max_angle>${lidar_half_fov}</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>0.01</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.08</min>
                    <max>10.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
        </sensor>
    </gazebo>
</robot>

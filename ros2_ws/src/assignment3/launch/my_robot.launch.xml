<?xml version="1.0"?>
<!--Brings up the simulation: Gazebo with the custom world, the
robot spawned into it, the bridge between Gazebo and ROS2, and RViz-->

<launch>
<arg name="headless" default="false"
    description="Run Gazebo without the GUI client"/>
<!--RViz is a second 3D window. Turning it off leaves more for Gazebo,
which helps when recording in the virtual machine.-->
<arg name="rviz" default="true"
    description="Start RViz alongside Gazebo"/>
<!--The three configurations are 120/30, 180/45 and 360/90, which all keep
the rays about 4 degrees apart.-->
<arg name="lidar_fov" default="180" description="Field of view in degrees"/>
<arg name="lidar_rays" default="45" description="Number of rays"/>
<!--Speed and turn rate are scaled together so the turn radius stays the
same. Lower both to record, since the lidar visual lags at full speed.-->
<arg name="speed" default="1.5" description="Forward speed in m/s"/>
<arg name="max_turn" default="7.2" description="Turn rate limit in rad/s"/>
<!--Paths resolved from the installed package.-->
<let name="pkg_share" value="$(find-pkg-share assignment3)"/>
<let name="xacro_path" value="$(var pkg_share)/urdf/my_robot.urdf.xacro"/>
<let name="world_path" value="$(var pkg_share)/worlds/maze.world"/>
<let name="bridge_config_path" value="$(var pkg_share)/config/gz_bridge.yaml"/>
<let name="rviz_config" value="$(var pkg_share)/rviz/urdf_config.rviz"/>

<!--gz_server computes the physics, gz_client draws it. The client can be
skipped when only RViz is needed.-->
<!--The server is left on its default so the world file can pick the engine
for the sensors, which it asks to be ogre2. Only the client is forced to
ogre v1, because ogre2 draws a black scene here.-->
<executable cmd="gz sim -s -r $(var world_path)"
            name="gz_server" output="screen"/>
<executable cmd="gz sim -g --render-engine-gui ogre" name="gz_client" output="screen"
            unless="$(var headless)"/>

<!--Expands the xacro, publishes it on /robot_description, and turns joint
states into transforms.-->
<node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description"
        value="$(command 'xacro $(var xacro_path) lidar_fov:=$(var lidar_fov) lidar_rays:=$(var lidar_rays)')"
        type="str"/>
    <param name="use_sim_time" value="true"/>
</node>

<!--Reads the description off /robot_description and spawns it. The name
must match the one used in the bridge config.-->
<node pkg="ros_gz_sim" exec="create"
      args="-topic robot_description -name my_robot -z 0.05"/>

<!--Passes topics between Gazebo and ROS, as listed in the config file.-->
<node pkg="ros_gz_bridge" exec="parameter_bridge">
    <param name="config_file" value="$(var bridge_config_path)"/>
    <param name="use_sim_time" value="true"/>
</node>

<!--The wall follower. It starts paused, so nothing moves until
"ros2 service call /toggle_pause std_srvs/srv/Trigger" is called.
Everything that is tuned lives here, not in the node.-->
<node pkg="assignment3" exec="mazerunner" output="screen">
    <param name="wall_distance" value="0.45"/>
    <param name="lookahead" value="0.9"/>
    <param name="speed" value="$(var speed)"/>
    <param name="gain" value="1.6"/>
    <param name="max_turn" value="$(var max_turn)"/>
    <param name="front_stop" value="0.6"/>
    <param name="sector" value="8.0"/>
    <param name="use_sim_time" value="true"/>
</node>

<!--RViz with the saved config: fixed frame base_footprint-->
<node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config)" if="$(var rviz)">
    <param name="use_sim_time" value="true"/>
</node>
</launch> 
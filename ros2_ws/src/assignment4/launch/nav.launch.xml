<?xml version="1.0"?>
<!--Assignment 4. Brings up Gazebo with the maze, the robot, the bridge,
slam_toolbox building the map, and RViz. Task 2 adds Nav2 and Task 3 adds
the explorer to this same file.-->

<launch>
<arg name="headless" default="false"
    description="Run Gazebo without the GUI client"/>
<arg name="rviz" default="true"
    description="Start RViz alongside Gazebo"/>

<!--Paths resolved from the installed package.-->
<let name="pkg_share" value="$(find-pkg-share assignment4)"/>
<let name="xacro_path" value="$(var pkg_share)/urdf/my_robot.urdf.xacro"/>
<let name="world_path" value="$(var pkg_share)/worlds/maze.world"/>
<let name="bridge_config_path" value="$(var pkg_share)/config/gz_bridge.yaml"/>
<let name="slam_config_path" value="$(var pkg_share)/config/slam.yaml"/>
<let name="nav2_config_path" value="$(var pkg_share)/config/nav2.yaml"/>
<let name="rviz_config" value="$(var pkg_share)/rviz/urdf_config.rviz"/>

<!--gz_server computes the physics, gz_client draws it. The client is forced
to ogre v1, because ogre2 draws a black scene here.-->
<executable cmd="gz sim -s -r $(var world_path)"
            name="gz_server" output="screen"/>
<executable cmd="gz sim -g --render-engine-gui ogre" name="gz_client"
            output="screen" unless="$(var headless)"/>

<!--Expands the xacro and publishes the transforms. The lidar comes out at
360 degrees and 360 rays, the defaults in my_robot.urdf.xacro.-->
<node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description"
        value="$(command 'xacro $(var xacro_path)')" type="str"/>
    <param name="use_sim_time" value="true"/>
</node>

<!--Spawns the robot from /robot_description. The name must match the one
used in the bridge config.-->
<node pkg="ros_gz_sim" exec="create"
      args="-topic robot_description -name my_robot -z 0.05"/>

<!--Passes topics between Gazebo and ROS, as listed in the config file.-->
<node pkg="ros_gz_bridge" exec="parameter_bridge">
    <param name="config_file" value="$(var bridge_config_path)"/>
    <param name="use_sim_time" value="true"/>
</node>

<!--Builds the map from /scan and the odometry. Included from slam_toolbox's
own launch file, because the node is a lifecycle node in Jazzy and that file
is what configures and activates it.-->
<include file="$(find-pkg-share slam_toolbox)/launch/online_async_launch.py">
    <arg name="slam_params_file" value="$(var slam_config_path)"/>
    <arg name="use_sim_time" value="true"/>
</include>

<!--The Nav2 stack: planner, controller, behaviours and the BT navigator.
navigation_launch.py and not bringup_launch.py, because slam_toolbox already
provides the map and the map->odom transform, so map_server and AMCL are
not wanted.-->
<include file="$(find-pkg-share nav2_bringup)/launch/navigation_launch.py">
    <arg name="params_file" value="$(var nav2_config_path)"/>
    <arg name="use_sim_time" value="true"/>
</include>

<node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config)" if="$(var rviz)">
    <param name="use_sim_time" value="true"/>
</node>
</launch>
